[global]
monitor=0
follow=mouse
indicate_hidden=yes

font=Hack14
format="<b>%s</b>\n%b"
sort=yes
alignment=left
show_age_threshold=60
word_wrap=yes
ignore_newline=no
stack_duplicates=true
hide_duplicate_count=false

frame_width=2
frame_color="#444444"
separator_height=2
padding=8
horizontal_padding=10

corner_radius=8

icon_theme=Papirus
icon_position=left
max_icon_size=32

sticky_history=yes
history_length=20
always_run_script=true
mouse_left_click=close_current
mouse_middle_click=do_action

[urgency_low]
background="#E5E0E0"
foreground="#1A2626"
frame_color="#5F8787"
timeout=5

[urgency_normal]
background="#B0E2FF"
foreground="#1A2626"
frame_color="#8DB6CD"
timeout=10

[urgency_critical]
background="#FF4500"
foreground="#FFFAFA"
frame_color="#CD3700"
timeout=0
